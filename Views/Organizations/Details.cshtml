
@model Sentinel.Web.Models.Organization

@{
    ViewData["Title"] = "Organization Details";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2>Organization Details</h2>
            <p class="text-muted mb-0">
                View organization information and associated projects.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            ← Back
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Organization Information</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Organization Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Created On</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </dd>

                <dt class="col-sm-3">Total Projects</dt>
                <dd class="col-sm-9">
                    @(Model.Projects?.Count ?? 0)
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit Organization
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Associated Projects</h5>
        </div>

        <div class="card-body">
            @if (Model.Projects == null || !Model.Projects.Any())
            {
                <p class="text-muted mb-0">
                    No projects are associated with this organization yet.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Project Name</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model.Projects)
                            {
                                <tr>
                                    <td>@project.Name</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(project.Description)
                                            ? "—"
                                            : project.Description)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
