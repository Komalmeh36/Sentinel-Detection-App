
@model IEnumerable<Sentinel.Web.Models.Organization>

@{
    ViewData["Title"] = "Organizations";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2>Organizations</h2>
            <p class="text-muted mb-0">
                Manage organizations and their registered projects.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Organization
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h5>No organizations yet</h5>
                <p class="text-muted">
                    Create an organization to start managing its projects.
                </p>
                <a asp-action="Create" class="btn btn-primary">
                    Create Organization
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Organization Name</th>
                        <th>Projects</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var organization in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">
                                    @organization.Name
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill text-bg-primary">
                                    @(organization.Projects?.Count ?? 0)
                                </span>
                            </td>
                            <td>
                                @organization.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@organization.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@organization.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Details
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteOrganizationModal"
                                            data-organization-id="@organization.Id"
                                            data-organization-name="@organization.Name">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Organization Delete Confirmation Modal -->
<div class="modal fade" id="deleteOrganizationModal" tabindex="-1"
     aria-labelledby="deleteOrganizationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteOrganizationModalLabel">
                    Delete Organization?
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>
                    Are you sure you want to delete
                    <strong id="deleteOrganizationName">this organization</strong>?
                </p>
                <p class="text-muted small mb-0">
                    This action cannot be undone.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form id="deleteOrganizationForm" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Delete Organization
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteModal =
            document.getElementById("deleteOrganizationModal");

        deleteModal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;

            const organizationId =
                button.getAttribute("data-organization-id");

            const organizationName =
                button.getAttribute("data-organization-name");

            document.getElementById("deleteOrganizationName").textContent =
                organizationName;

            document.getElementById("deleteOrganizationForm").action =
                "/Organizations/Delete/" + organizationId;
        });
    });
</script>
