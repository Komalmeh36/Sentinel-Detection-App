
@model Sentinel.Web.Models.Organization

@{
    ViewData["Title"] = "Delete Organization";
}

<div class="container mt-4">
    <h1>Delete Organization</h1>

    <div class="alert alert-warning mt-3">
        <strong>Warning!</strong> Are you sure you want to delete this organization?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5>Organization Details</h5>

            <p>
                <strong>Name:</strong> @Model.Name
            </p>

            <p>
                <strong>Created:</strong>
                @Model.CreatedAt.ToString("dd MMM yyyy")
            </p>

            <p>
                <strong>Assigned Projects:</strong>
                @Model.Projects.Count
            </p>

            @if (Model.Projects.Any())
            {
                <div class="alert alert-danger">
                    This organization has projects assigned to it.
                    You must reassign or remove those projects before deleting it.
                </div>

                <a asp-action="Index" class="btn btn-secondary">
                    Back to Organizations
                </a>
            }
            else
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </form>
            }
        </div>
    </div>
</div>
