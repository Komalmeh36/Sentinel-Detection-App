
@model Sentinel.Web.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2>Project Details</h2>
            <p class="text-muted mb-0">View information about this project.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                ← Back
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">@Model.Name</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided"
                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Organization</dt>
                <dd class="col-sm-9">
                    @(Model.Organization?.Name ?? "Not assigned")
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsArchived)
                    {
                        <span class="badge bg-secondary">Archived</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Services</h5>
        </div>

        <div class="card-body">
            @if (Model.Services == null || !Model.Services.Any())
            {
                <p class="text-muted mb-0">
                    No services have been added to this project yet.
                </p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var service in Model.Services)
                    {
                        <li class="list-group-item">@service.Name</li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
