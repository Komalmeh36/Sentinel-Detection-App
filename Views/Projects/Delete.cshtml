
@model Sentinel.Web.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container-fluid px-0">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2>Delete Project</h2>
            <p class="text-muted mb-0">
                Review the project information before deleting it.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            ← Back to Projects
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Confirm Project Deletion</h5>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong>
                Are you sure you want to delete this project?
                This action cannot be undone.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Project ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Project Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided"
                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Organization</dt>
                <dd class="col-sm-9">
                    @(Model.Organization?.Name ?? "Not assigned")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @(Model.IsArchived ? "Archived" : "Active")
                </dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>
