
@model Sentinel.Web.Models.Project

@{
    ViewData["Title"] = "Add Project";
}

<div class="container mt-4">
    <h1>Add Project</h1>
    <p class="text-muted">Register a project to monitor in Sentinel.</p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Project Name</label>
                    <input asp-for="Name" class="form-control"
                           placeholder="e.g., E-commerce Platform" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control"
                              rows="4"
                              placeholder="Describe the project..."></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="OrganizationId"
                           class="form-label">Organization</label>
                    <select asp-for="OrganizationId" class="form-select">
                        <option value="">-- Select Organization --</option>
                        @if (ViewBag.Organizations != null)
                        {
                            foreach (var organization in ViewBag.Organizations)
                            {
                                <option value="@organization.Id">
                                    @organization.Name
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="OrganizationId"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsArchived" class="form-check-input" />
                    <label asp-for="IsArchived" class="form-check-label">
                        Archived
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Project
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
