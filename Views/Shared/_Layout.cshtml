
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sentinel</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/Sentinel.styles.css"
          asp-append-version="true" />
</head>

<body class="sentinel-body">
    <div class="sentinel-layout">

        <!-- Sidebar -->
        <aside class="sentinel-sidebar">
            <a asp-controller="Home" asp-action="Index"
               class="sentinel-brand">
                <span class="sentinel-brand-icon">S</span>
                <span>
                    <span class="sentinel-brand-name">SENTINEL</span>
                    <small class="sentinel-brand-caption">
                        SECURITY MONITORING
                    </small>
                </span>
            </a>

            <div class="sentinel-nav-label">WORKSPACE</div>

            <nav class="sentinel-navigation">
                <a asp-controller="Home" asp-action="Index"
                   class="sentinel-nav-link @(
                       ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
                           ? "active" : "")">
                    <span class="sentinel-nav-icon">▦</span>
                    <span>Dashboard</span>
                </a>

                <div class="sentinel-nav-label mt-4">MANAGEMENT</div>

                <a asp-controller="Organizations" asp-action="Index"
                   class="sentinel-nav-link @(
                       ViewContext.RouteData.Values["controller"]?.ToString() == "Organizations"
                           ? "active" : "")">
                    <span class="sentinel-nav-icon">◈</span>
                    <span>Organizations</span>
                </a>

                <a asp-controller="Projects" asp-action="Index"
                   class="sentinel-nav-link @(
                       ViewContext.RouteData.Values["controller"]?.ToString() == "Projects"
                           ? "active" : "")">
                    <span class="sentinel-nav-icon">▣</span>
                    <span>Projects</span>
                </a>

                <a asp-controller="Services" asp-action="Index"
                   class="sentinel-nav-link @(
                       ViewContext.RouteData.Values["controller"]?.ToString() == "Services"
                           ? "active" : "")">
                    <span class="sentinel-nav-icon">⌘</span>
                    <span>Services</span>
                </a>

                <div class="sentinel-nav-label mt-4">MONITORING</div>

                <a asp-controller="EventItems" asp-action="Index"
                   class="sentinel-nav-link @(
                       ViewContext.RouteData.Values["controller"]?.ToString() == "EventItems"
                           ? "active" : "")">
                    <span class="sentinel-nav-icon">⌁</span>
                    <span>Errors &amp; Events</span>
                </a>

                <a asp-controller="AuditLogs" asp-action="Index"
                   class="sentinel-nav-link @(
                       ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs"
                           ? "active" : "")">
                    <span class="sentinel-nav-icon">≡</span>
                    <span>Audit Logs</span>
                </a>
            </nav>

            <div class="sentinel-sidebar-footer">
                <div class="sentinel-status-dot"></div>
                <div>
                    <div class="sentinel-status-title">Sentinel System</div>
                    <div class="sentinel-status-caption">
                        Application workspace
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main content -->
        <div class="sentinel-main">

            <header class="sentinel-topbar">
                <div>
                    <div class="sentinel-breadcrumb">
                        SECURITY PLATFORM
                        <span>/</span>
                        @ViewData["Title"]
                    </div>
                    <div class="sentinel-page-heading">
                        @ViewData["Title"]
                    </div>
                </div>

                <div class="sentinel-topbar-right">
                    <span class="sentinel-environment">
                        <span class="sentinel-status-dot"></span>
                        Development
                    </span>
                </div>
            </header>

            <main role="main" class="sentinel-content">
                @RenderBody()
            </main>

            <footer class="sentinel-footer">
                <span>© 2026 Sentinel</span>
                <span>Application Security &amp; Event Monitoring</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
