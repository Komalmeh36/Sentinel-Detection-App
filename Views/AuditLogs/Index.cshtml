
@model IEnumerable<Sentinel.Web.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">Audit Logs</h2>
            <p class="text-secondary mb-0">
                Track recorded activities and changes in Sentinel.
            </p>
        </div>

        <span class="badge bg-secondary">
            @(Model?.Count() ?? 0) Records
        </span>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>User</th>
                                <th>Details</th>
                                <th>Timestamp</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">
                                            @log.Action
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(log.UserId)
                                            ? "System"
                                            : log.UserId)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(log.Details)
                                            ? "No details"
                                            : log.Details)
                                    </td>

                                    <td class="text-nowrap">
                                        @(log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt"))
                                    </td>

                                    <td>
                                        <a asp-controller="AuditLogs"
                                           asp-action="Details"
                                           asp-route-id="@log.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5>No audit logs yet</h5>
                    <p class="text-secondary mb-0">
                        Recorded activities will appear here when logging is implemented.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
