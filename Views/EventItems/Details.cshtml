
@model Sentinel.Web.Models.EventItem

@{
    ViewData["Title"] = "Event Details";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="mb-1">Event Details</h2>
            <p class="text-secondary mb-0">Review event information and current status.</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">← Back</a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Event Information</h5>
        </div>
        <div class="card-body">
            <h4>@Model.Title</h4>
            <p class="text-secondary">@Model.Message</p>
            <hr />

            <dl class="row">
                <dt class="col-sm-3 mb-2">Type</dt>
                <dd class="col-sm-9 mb-3">@Model.Type</dd>

                <dt class="col-sm-3 mb-2">Severity</dt>
                <dd class="col-sm-9 mb-3">@Model.Severity</dd>

                <dt class="col-sm-3 mb-2">Status</dt>
                <dd class="col-sm-9 mb-3">@Model.Status</dd>

                <dt class="col-sm-3 mb-2">Service</dt>
                <dd class="col-sm-9 mb-3">@(Model.Service?.Name ?? "Unknown")</dd>

                <dt class="col-sm-3 mb-2">Created On</dt>
                <dd class="col-sm-9 mb-3">
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </dd>
            </dl>

            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Event</a>
                <button type="button" class="btn btn-outline-danger"
                        data-bs-toggle="modal" data-bs-target="#deleteEventModal">
                    Delete Event
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteEventModal" tabindex="-1"
     aria-labelledby="deleteEventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteEventModalLabel">Delete Event?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong>@Model.Title</strong>?
                <p class="text-secondary small mt-2 mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Event</button>
                </form>
            </div>
        </div>
    </div>
</div>
