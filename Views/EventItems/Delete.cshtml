
@model Sentinel.Web.Models.EventItem

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <h2 class="mb-1">Delete Event</h2>
        <p class="text-secondary mb-0">
            Confirm whether you want to permanently delete this event.
        </p>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Confirm Deletion</h5>
        </div>

        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                Are you sure you want to delete this event? This action cannot be undone.
            </div>

            <h5>@Model.Title</h5>
            <p class="text-secondary">@Model.Message</p>

            <dl class="row mt-4">
                <dt class="col-sm-3 mb-2">Event ID</dt>
                <dd class="col-sm-9 mb-3">@Model.Id</dd>

                <dt class="col-sm-3 mb-2">Type</dt>
                <dd class="col-sm-9 mb-3">@Model.Type</dd>

                <dt class="col-sm-3 mb-2">Severity</dt>
                <dd class="col-sm-9 mb-3">@Model.Severity</dd>

                <dt class="col-sm-3 mb-2">Status</dt>
                <dd class="col-sm-9 mb-3">@Model.Status</dd>

                <dt class="col-sm-3 mb-2">Service</dt>
                <dd class="col-sm-9 mb-3">@(Model.Service?.Name ?? "Unknown")</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>

                    <a asp-action="Index" class="btn btn-outline-light">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
