
@model Sentinel.Web.Models.Service

@{
    ViewData["Title"] = "Delete Service";
}

<div class="container mt-4">
    <h2>Delete Service</h2>
    <p class="text-muted">Review the service before deleting it.</p>

    <div class="alert alert-warning">
        <strong>Warning:</strong> Are you sure you want to delete this service?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Service ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Service Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Project</dt>
                <dd class="col-sm-9">
                    @(Model.Project?.Name ?? "Not assigned")
                </dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
