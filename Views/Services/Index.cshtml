
@model IEnumerable<Sentinel.Web.Models.Service>

@{
    ViewData["Title"] = "Services";
}

<div class="container-fluid px-0">

    <!-- Page heading -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-2">Services</h2>
            <p class="text-muted mb-0">
                Manage the services monitored by Sentinel.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Service
        </a>
    </div>

    <!-- Services list -->
    @if (Model == null || !Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h5>No services yet</h5>
                <p class="text-muted">
                    Add a service to start monitoring your projects.
                </p>
                <a asp-action="Create" class="btn btn-primary">
                    + Add Service
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Service Name</th>
                                <th>Project</th>
                                <th class="pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var service in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold">
                                            @service.Name
                                        </span>
                                    </td>

                                    <td>
                                        @(service.Project?.Name ?? "Not assigned")
                                    </td>

                                    <td class="pe-4">
                                        <div class="d-flex flex-wrap gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@service.Id"
                                               class="btn btn-sm btn-outline-light">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@service.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteServiceModal"
                                                    data-service-id="@service.Id"
                                                    data-service-name="@service.Name">
                                                Delete
                                            </button>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete confirmation popup -->
<div class="modal fade" id="deleteServiceModal"
     tabindex="-1"
     aria-labelledby="deleteServiceModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteServiceModalLabel">
                    Delete Service?
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete
                <strong id="deleteServiceName">this service</strong>?
            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form id="deleteServiceForm" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("deleteServiceModal");

        modal.addEventListener("show.bs.modal", function (event) {
            const button = event.relatedTarget;

            const serviceId =
                button.getAttribute("data-service-id");

            const serviceName =
                button.getAttribute("data-service-name");

            document.getElementById("deleteServiceName").textContent =
                serviceName;

            document.getElementById("deleteServiceForm").action =
                "/Services/Delete/" + serviceId;
        });
    });
</script>
