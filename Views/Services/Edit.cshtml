
@model Sentinel.Web.Models.Service

@{
    ViewData["Title"] = "Edit Service";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Edit Service</h2>
        <p class="text-muted">Update your service details.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Service Name
                    </label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProjectId" class="form-label">
                        Project
                    </label>
                    <select asp-for="ProjectId" class="form-select"
                            asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Projects, "Id", "Name"))">
                        <option value="">-- Select a Project --</option>
                    </select>
                    <span asp-validation-for="ProjectId"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
